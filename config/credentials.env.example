# 이 파일을 config/credentials.env 로 복사해서 값을 채우세요.
# credentials.env 는 .gitignore 에 등록되어 커밋되지 않습니다.
# 발급 방법: docs/google_ads_api.md

# scripts/get_refresh_token.py 가 아래 3개를 자동으로 채워줍니다
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Google Ads > 도구 및 설정 > 설정 > API 센터 (MCC 계정에서만 보임)
GOOGLE_ADS_DEVELOPER_TOKEN=

# 데이터를 읽을 광고 계정 ID (하이픈 없이 10자리)
GOOGLE_ADS_CUSTOMER_ID=

# 위 계정을 관리하는 MCC 계정 ID (MCC 아래에 있다면 필수)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# 선택: API 버전 고정 (미지정 시 v22)
# GOOGLE_ADS_API_VERSION=v23

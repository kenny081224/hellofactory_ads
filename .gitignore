# 실제 계정 데이터는 커밋하지 않습니다 (CSV 외 메모·엑셀도 포함)
data/raw/*
!data/raw/README.md
data/processed/*
reports/*.md
campaigns/generated/*.csv

# 예시 데이터와 안내 문서는 유지
!data/raw/README.md
!data/sample/*

__pycache__/
*.pyc
.DS_Store

# 빈 폴더 유지
!reports/.gitkeep
!data/processed/.gitkeep
!campaigns/generated/.gitkeep

# 인증 정보 (절대 커밋 금지)
config/credentials.env
